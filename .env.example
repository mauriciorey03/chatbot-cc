# ── Twilio (reemplaza Meta Cloud API) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Anthropic Claude API ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
# Opcional: modelo a usar (por defecto claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Base de datos del CRM (SQL Server / Azure SQL, misma del bot general) ──
DB_SERVER=your-server.database.windows.net
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# ── Autorización de datos personales / identificación ─────────────────────
POLICY_URL=https://example.com/politica-de-datos
# Opcional: registro web al que se remite tras 3 cédulas no encontradas
# REGISTER_URL=https://...
# Minutos de inactividad tras los cuales se vuelve a pedir la cédula (por defecto 30)
# AUTH_TIMEOUT_MINUTES=30

# ── Servidor ───────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=https://your-ngrok-or-domain.com
